{
  "name": "Supabase Self-Hosted",
  "version": "1.1.1",
  "description": "Instance Supabase auto-hébergée complète avec Studio, Auth, REST, Realtime, Storage et PostgreSQL.",
  "category": "backend",
  "framework": "docker-compose",
  "type": "docker-compose",
  "tags": ["supabase", "postgres", "baas", "self-hosted", "auth", "storage", "realtime"],
  "features": [
    "Studio UI",
    "GoTrue Auth",
    "PostgREST API",
    "Realtime subscriptions",
    "Storage API",
    "PostgreSQL 15",
    "Kong API Gateway"
  ],
  "requirements": {
    "min_ram_mb": 2048,
    "min_disk_gb": 10,
    "docker": true,
    "docker_compose": true
  },
  "deploy": {
    "compose_file": "docker-compose.yml",
    "env_file": ".env"
  },
  "healthCheck": {
    "internal": [
      { "name": "Auth", "url": "http://127.0.0.1:8000/auth/v1/health", "expectedStatus": 200 },
      { "name": "REST", "url": "http://127.0.0.1:8000/rest/v1/", "expectedStatus": 200 },
      { "name": "Storage", "url": "http://127.0.0.1:8000/storage/v1/status", "expectedStatus": 200 },
      { "name": "Studio", "url": "http://127.0.0.1:3000", "expectedStatus": 200 }
    ],
    "external": [
      { "name": "Auth", "path": "/auth/v1/health", "expectedStatus": 200 },
      { "name": "REST", "path": "/rest/v1/", "expectedStatus": 200 },
      { "name": "Storage", "path": "/storage/v1/status", "expectedStatus": 200 }
    ],
    "timeout_seconds": 300,
    "retry_on_fail": true
  },
  "policies": {
    "ban_latest": true,
    "strict_mode": true,
    "tested": true,
    "idempotency_verified": true
  },
  "variables": [
    { "key": "POSTGRES_PASSWORD", "required": true, "generate": "random_32" },
    { "key": "JWT_SECRET", "required": true, "generate": "random_64" },
    { "key": "ANON_KEY", "required": true, "generate": "jwt_anon" },
    { "key": "SERVICE_ROLE_KEY", "required": true, "generate": "jwt_service" },
    { "key": "SITE_URL", "required": true, "default": "http://localhost:3000" },
    { "key": "API_EXTERNAL_URL", "required": true, "default": "http://localhost:8000" },
    { "key": "SUPABASE_PUBLIC_URL", "required": true, "default": "http://localhost:8000" },
    { "key": "STUDIO_PORT", "required": false, "default": "3000" },
    { "key": "KONG_HTTP_PORT", "required": false, "default": "8000" },
    { "key": "POSTGRES_PORT", "required": false, "default": "5432" },
    { "key": "DISABLE_SIGNUP", "required": false, "default": "false" },
    { "key": "ENABLE_EMAIL_AUTOCONFIRM", "required": false, "default": "false" },
    { "key": "SMTP_HOST", "required": false },
    { "key": "SMTP_PORT", "required": false, "default": "587" },
    { "key": "SMTP_USER", "required": false },
    { "key": "SMTP_PASS", "required": false },
    { "key": "SMTP_ADMIN_EMAIL", "required": false }
  ]
}
