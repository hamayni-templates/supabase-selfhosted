# ============================================
# Supabase Self-Hosted — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked [GENERATED] will be auto-generated by Hamayni during deployment.

# --- Database ---
POSTGRES_PASSWORD=          # [GENERATED] random_32
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- JWT ---
JWT_SECRET=                 # [GENERATED] random_64
JWT_EXPIRY=3600
ANON_KEY=                   # [GENERATED] jwt_anon
SERVICE_ROLE_KEY=           # [GENERATED] jwt_service

# --- URLs ---
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# --- Ports ---
STUDIO_PORT=3000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# --- Auth ---
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# --- Realtime ---
REALTIME_SECRET_KEY_BASE=   # [GENERATED] random_64
