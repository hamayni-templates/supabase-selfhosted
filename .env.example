# Supabase Self-Hosted — Environment Variables
# Copy this file to .env and fill in the values

# Required — PostgreSQL superuser password
POSTGRES_PASSWORD=your-super-secret-password

# Required — JWT secret (min 32 chars, used by GoTrue and Kong)
JWT_SECRET=your-super-secret-jwt-token-min-32-chars

# Required — Supabase keys (generate at https://supabase.com/docs/guides/self-hosting#api-keys)
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# Optional — Studio dashboard credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# Optional — Public URL (set to your domain)
SITE_URL=http://localhost:8000

# Optional — SMTP for email delivery
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_NAME=Supabase
